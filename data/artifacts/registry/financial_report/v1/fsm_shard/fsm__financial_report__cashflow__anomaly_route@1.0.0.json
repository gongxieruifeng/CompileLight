          "event": "CASHFLOW_COMPLETE",
          "from_state": "cashflow_ready",
          "guard": "OCF 和净利润存在",
          "to_state": "compare"
        },
        {
          "event": "DIVERGENCE_COMPUTED",
          "from_state": "compare",
          "guard": "偏离比例可计算",
          "to_state": "score"
        },
        {
          "event": "SCORE_READY",
          "from_state": "score",
          "guard": "高风险进入人工复核",
          "to_state": "validated"
        }
      ]
    },
    "contract": {
