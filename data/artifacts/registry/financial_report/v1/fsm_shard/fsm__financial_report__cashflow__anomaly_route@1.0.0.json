{
  "asset": {
    "asset_id": "fsm.financial_report.cashflow.anomaly_route",
    "body": {
      "directly_executable": true,
      "kind": "FSM_SHARD",
      "start_state": "cashflow_ready",
      "states": [
        {
          "invariant": "现金流事实已分类。",
          "state_id": "cashflow_ready"
        },
        {
          "invariant": "经营现金流和净利润可比较。",
          "state_id": "compare"
        },
        {
          "invariant": "异常分数位于 0 到 100。",
          "state_id": "score"
        },
        {
          "invariant": "风险输出等待 Validator。",
          "state_id": "validated"
        }
      ],
      "subgoal": "完成经营现金流与净利润偏离的异常识别。",
      "terminal_states": [
        "validated"
      ],
      "transitions": [
